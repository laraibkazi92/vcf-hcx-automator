{
   "swagger":"2.0",
   "info":{
      "description":"APIs to provide authentication, session and job information.",
      "version":"1.0",
      "title":"Authentication, session and job APIs",
      "contact":{
         "name":"VMware"
      },
      "license":{
         "name":"Copyright (c) 2020-2021 VMware, Inc. All rights reserved."
      }
   },
   "schemes":[
      "https"
   ],
   "consumes":[
      "application/json"
   ],
   "produces":[
      "application/json"
   ],
   "paths":{
      "/hybridity/api/sessions":{
         "post":{
            "summary":"Create API session",
            "consumes":[
               "application/json"
            ],
            "parameters":[
               {
                  "name":"Accept",
                  "in":"header",
                  "required":true,
                  "type":"string",
                  "description":"application/json",
                  "default":"application/json",
                  "x-example":"application/json"
               },
               {
                  "name":"Content-Type",
                  "in":"header",
                  "required":true,
                  "type":"string",
                  "description":"application/json",
                  "x-example":"application/json"
               },
               {
                  "name":"body",
                  "in":"body",
                  "required":true,
                  "schema":{
                     "type":"object",
                     "required":[
                        "password",
                        "username"
                     ],
                     "properties":{
                        "username":{
                           "type":"string",
                           "example":"username@vsphere.local"
                        },
                        "password":{
                           "type":"string",
                           "example":"password"
                        }
                     }
                  }
               }
            ],
            "responses":{
               "200":{
                  "description":"Status 200",
                  "headers":{
                     "x-hm-authorization":{
                        "type":"string",
                        "description":"Authorization token to be used for subsequent API calls.",
                        "x-example":"41f9b903:a9ca:482c:a652:d3dc41bc436e"
                     }
                  }
               }
            }
         }
      },
      "/hybridity/api/jobs/{jobid}":{
         "get":{
            "responses":{
               "200":{
                  "description":"Accepted",
                  "schema":{
                     "type":"object",
                     "properties":{
                        "jobId":{
                           "type":"string"
                        },
                        "enterprise":{
                           "type":"string"
                        },
                        "organization":{
                           "type":"string"
                        },
                        "username":{
                           "type":"string"
                        },
                        "isQueued":{
                           "type":"boolean"
                        },
                        "isCancelled":{
                           "type":"boolean"
                        },
                        "isRolledBack":{
                           "type":"boolean"
                        },
                        "createTimeEpoch":{
                           "type":"integer"
                        },
                        "absoluteExpireTimeEpoch":{
                           "type":"integer"
                        },
                        "startTime":{
                           "type":"integer"
                        },
                        "endTime":{
                           "type":"integer"
                        },
                        "percentComplete":{
                           "type":"integer"
                        },
                        "isDone":{
                           "type":"boolean"
                        },
                        "didFail":{
                           "type":"boolean"
                        },
                        "timeToExecute":{
                           "type":"integer"
                        }
                     }
                  }
               },
               "401":{
                  "description":"Unauthorized"
               },
               "403":{
                  "description":"Forbidden"
               }
            },
            "security":[
               {
                  "x-hm-authorization":[

                  ]
               }
            ],
            "parameters":[
               {
                  "name":"jobid",
                  "in":"path",
                  "required":true,
                  "type":"string"
               }
            ]
         }
      }
   },
   "securityDefinitions":{
      "x-hm-authorization":{
         "description":"Obtained from /hybridity/api/session",
         "type":"apiKey",
         "name":"x-hm-authorization",
         "in":"header"
      }
   }
}